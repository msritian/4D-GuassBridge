# Jitter diagnosis on a CHTC GPU (scripts/diagnose_jitter.py). Submit from ~/gaussbridge/diag/; inputs from
# ../overfit/. Output: $(out).tar.gz.
out                     = diag_fixes
runs                    = stack_allgoals.tar.gz stack_uni.tar.gz stack_smooth.tar.gz stack_uni_smooth.tar.gz
universe                = container
container_image         = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable              = diagnose_jitter.sh
arguments               = $(out) $(runs)
transfer_input_files    = gb_code.tar.gz, ../overfit/episodes_stack_dev.tar, ../overfit/stack_allgoals.tar.gz, ../overfit/stack_uni.tar.gz, ../overfit/stack_smooth.tar.gz, ../overfit/stack_uni_smooth.tar.gz
transfer_output_files   = $(out).tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

request_gpus            = 1
+WantGPULab             = true
+GPUJobLength           = "short"
+is_resumable           = true
gpus_minimum_memory     = 16G
# torch 2.5.1 (cu124): no Blackwell kernels (job 8539255), see CLAUDE.md §3.5
gpus_minimum_capability = 8.0
gpus_maximum_capability = 9.0
request_cpus            = 4
request_memory          = 16GB
request_disk            = 10GB

log    = logs/$(out)_$(Cluster).log
output = logs/$(out)_$(Cluster).out
error  = logs/$(out)_$(Cluster).err
queue 1
