# Jitter diagnosis on a CHTC GPU (scripts/diagnose_jitter.py). Submit from ~/gaussbridge/diag/ (inputs from
# ../overfit/ and the C4 trial run on /staging). Output: diag_stack.tar.gz.
universe                = container
container_image         = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable              = diagnose_jitter.sh
transfer_input_files    = gb_code.tar.gz, ../overfit/episodes_stack_dev.tar, ../overfit/stack_allgoals.tar.gz, osdf:///chtc/staging/s/smittal39/gaussbridge/trial_stackcube_dev.tar.gz
transfer_output_files   = diag_stack.tar.gz
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
Requirements            = (Target.HasCHTCStaging == true)

request_gpus            = 1
+WantGPULab             = true
+GPUJobLength           = "short"
+is_resumable           = true
gpus_minimum_memory     = 16G
# torch 2.5.1 (cu124): no Blackwell kernels (job 8539255), see CLAUDE.md §3.5
gpus_minimum_capability = 8.0
gpus_maximum_capability = 9.0
request_cpus            = 4
request_memory          = 16GB
request_disk            = 10GB

log    = logs/diag_$(Cluster).log
output = logs/diag_$(Cluster).out
error  = logs/diag_$(Cluster).err
queue 1
