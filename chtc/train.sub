# C4 training on one CHTC GPU with self-checkpointing (CLAUDE.md §3.5, §8.2).
#
# How resuming works: train_motion.py checkpoints and exits with code 85 after --max-minutes. HTCondor then saves the
# run directory (transfer_checkpoint_files), restarts the job (maybe on another machine; +is_resumable allows
# backfill GPUs) and brings the directory back, and training continues from the newest checkpoint. Exit 0 = done:
# <run>.tar.gz (log, checkpoints, final_ema.pt) comes back to this folder.
#
# Build the bundle on the laptop:  bash chtc/pack.sh <episodes train dir> <episodes val dir> <out dir>
# Then on the submit node:         cd ~/gaussbridge/train && mkdir -p logs && condor_submit train.sub
#
# Edit the queue line at the bottom for the run: config file, run name, extra arguments (overrides).

universe                = container
container_image         = docker://pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
executable              = train.sh
arguments               = $(config) $(run) --max-minutes $(minutes) $(extra)
transfer_input_files    = gb_code.tar.gz, episodes_train.tar, episodes_val.tar
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
checkpoint_exit_code    = 85
transfer_checkpoint_files = $(run)
transfer_output_files   = $(run).tar.gz

request_gpus            = 1
+WantGPULab             = true
+GPUJobLength           = "short"
+is_resumable           = true
gpus_minimum_memory     = 24G
# torch 2.5.1 has no Blackwell (capability 12.x) kernels (job 8539255): A100, A30, A40, L40(S), H100, H200 only
gpus_minimum_capability = 8.0
gpus_maximum_capability = 9.0
request_cpus            = 4
request_memory          = 24GB
request_disk            = 20GB

log    = logs/$(run)_$(Cluster).log
output = logs/$(run)_$(Cluster).out
error  = logs/$(run)_$(Cluster).err

# config, run name, minutes per segment before checkpoint + restart, extra overrides
queue config, run, minutes, extra from (
  configs/train/stackcube_v1.yaml, trial_stackcube_dev, 12, --set optim.steps=3000 optim.warmup=200 log.val_loss_every=500 log.val_sample_every=1000 log.ckpt_every=500 log.val_max_cases=3
)
