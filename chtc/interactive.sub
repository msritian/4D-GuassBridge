# Interactive CPU session in the job image, for debugging: condor_submit -i chtc/interactive.sub
# Inside (needs chtc/code.tar, see gen_demos.sub):
#   bash run.sh out.tar bash code/chtc/gen_shard.sh StackCube-v1 smoke 0 2 2 && tar -tf out.tar
universe              = container
container_image       = docker://CHANGE_ME/gaussbridge-cpu:0.2
transfer_input_files  = chtc/code.tar, chtc/run.sh
should_transfer_files = YES
request_cpus          = 1
request_memory        = 4GB
request_disk          = 4GB
queue
